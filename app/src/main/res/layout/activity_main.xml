<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/btnSettings"
            style="@style/IconButton"
            android:contentDescription="@string/settings"
            android:text="⚙" />

        <TextView
            android:id="@+id/levelText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/coinsText"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/pill"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/gold"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Board -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.ballsort.game.GameView
            android:id="@+id/gameView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/winOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3000000"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:background="@drawable/card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎉"
                    android:textSize="48sp" />

                <TextView
                    android:id="@+id/winTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/winReward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/gold"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/btnCollectAd"
                    style="@style/BigButton"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/btn_green" />

                <TextView
                    android:id="@+id/btnNext"
                    style="@style/BigButton"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/btn_outline"
                    android:text="@string/next" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Booster buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/btnRestart"
            style="@style/BoosterButton"
            android:text="@string/btn_restart" />

        <TextView
            android:id="@+id/btnUndo"
            style="@style/BoosterButton"
            android:text="@string/btn_undo" />

        <TextView
            android:id="@+id/btnHint"
            style="@style/BoosterButton"
            android:text="@string/btn_hint" />

        <TextView
            android:id="@+id/btnTube"
            style="@style/BoosterButton"
            android:text="@string/btn_tube" />
    </LinearLayout>

    <!-- Banner ad -->
    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
